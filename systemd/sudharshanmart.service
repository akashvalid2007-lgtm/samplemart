[Unit]
Description=SudharshanMart Native C++20 Marketplace Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sudharshanmart
ExecStart=/opt/sudharshanmart/bin/sudharshanmart
Restart=always
RestartSec=5
Environment=PORT=8080
Environment=AI_CHATBOT_PROVIDER=mock
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
